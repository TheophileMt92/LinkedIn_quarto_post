```{r setup}
library(dplyr)
library(plotly)
library(leaflet)
library(reactable)
library(htmltools)

pal_ocean <- c(
  deep    = "#062d4a",
  mid     = "#0d4f7a",
  surface = "#1a7fa8",
  light   = "#4eb8d4",
  foam    = "#c8eaf4",
  accent  = "#12726B"
)
```

```{r data}
